# Required absolute host paths. Choose them for the machine running Docker.
NJS_AI_MODELS_ROOT=
NJS_AI_DATA_ROOT=
NJS_AI_CACHE_ROOT=
NJS_AI_REQUIRE_D_DRIVE=0
NJS_AI_NETWORK=njs-ai
NJS_AI_BIND_ADDRESS=127.0.0.1

# Optional internal model mirror (HTTPS base URL or local directory) and
# platform-separated roots from which already downloaded artifacts may be
# imported after checksum verification.
NJS_AI_MODEL_MIRROR=
NJS_AI_MODEL_IMPORT_ROOTS=

NJS_COMFYUI_REPOSITORY=https://github.com/Comfy-Org/ComfyUI.git
NJS_COMFYUI_REPOSITORY_MIRROR=
NJS_KJNODES_REPOSITORY=https://github.com/kijai/ComfyUI-KJNodes.git
NJS_KJNODES_REPOSITORY_MIRROR=
NJS_SAM2_NODE_REPOSITORY=https://github.com/neverbiasu/ComfyUI-SAM2.git
NJS_SAM2_NODE_REPOSITORY_MIRROR=
NJS_RMBG_NODE_REPOSITORY=https://github.com/1038lab/ComfyUI-RMBG.git
NJS_RMBG_NODE_REPOSITORY_MIRROR=

NJS_SAM2_PORT=8188
NJS_RMBG2_PORT=8189
NJS_LAMA_PORT=8090

NJS_RMBG2_LICENSE_ACCEPTED=
NJS_BIG_LAMA_LICENSE_ACCEPTED=
OPENAI_API_KEY=
